# Deep Research local configuration template.
# Copy to .env for local use. Never commit real credentials.

# Runtime identity
HARNESS_ENV=dev
FRONTEND_BASE_URL=http://127.0.0.1:24681

# Main chat model
MODEL_NAME=gpt-4.1-mini
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_EXTRA_API_KEYS=

# Optional recall and review models. Empty values inherit from the main model.
RECALL_MODEL_NAME=
RECALL_BASE_URL=
RECALL_API_KEY=
DREAM_MODEL_NAME=
DREAM_BASE_URL=
DREAM_API_KEY=

# Optional worker and ranker roles
WORKER_MODEL_NAME=
WORKER_BASE_URL=
WORKER_API_KEY=
RESEARCH_RANKER_MODEL_NAME=
RESEARCH_RANKER_BASE_URL=
RESEARCH_RANKER_API_KEY=
RESEARCH_RANKER_EXTRA_API_KEYS=

# Research evidence and writer roles. Writer may inherit evidence, then chat.
RESEARCH_EVIDENCE_MODEL_NAME=
RESEARCH_EVIDENCE_BASE_URL=
RESEARCH_EVIDENCE_API_KEY=
RESEARCH_EVIDENCE_EXTRA_API_KEYS=
RESEARCH_ROLE_MODEL_TIMEOUT_SECONDS=300
RESEARCH_SECTION_EVIDENCE_MODEL_TIMEOUT_SECONDS=300
RESEARCH_SECTION_EVIDENCE_TIMEOUT_SECONDS=1200
RESEARCH_QUESTION_EVIDENCE_MODEL_TIMEOUT_SECONDS=300
RESEARCH_QUESTION_EVIDENCE_TIMEOUT_SECONDS=1200
RESEARCH_WRITER_MODEL_NAME=
RESEARCH_WRITER_BASE_URL=
RESEARCH_WRITER_API_KEY=
RESEARCH_WRITER_EXTRA_API_KEYS=

# Optional unified model route. When enabled with at least one key, this route wins
# atomically over both the legacy preferred route and OPENAI_* for user-facing agents.
RESEARCH_UNIFIED_MODEL_CHANNEL_ENABLED=false
RESEARCH_UNIFIED_MODEL_NAME=
RESEARCH_UNIFIED_MODEL_BASE_URL=
RESEARCH_UNIFIED_MODEL_API_KEY=
RESEARCH_UNIFIED_MODEL_EXTRA_API_KEYS=

# Legacy preferred route (kept for compatibility) and shared route execution policy.
RESEARCH_PREFERRED_PROVIDER_ENABLED=false
RESEARCH_PREFERRED_MODEL_NAME=
RESEARCH_PREFERRED_BASE_URL=
RESEARCH_PREFERRED_API_KEY=
RESEARCH_PREFERRED_EXTRA_API_KEYS=
RESEARCH_PREFERRED_GATEWAY_MANAGED=false
# Leave these policy overrides empty to use route-aware defaults.
# Managed gateway: 64 concurrency / 300 acquire seconds / 2 gateway retries.
# Direct provider: 1 concurrency / 30 acquire seconds / 0 gateway retries.
RESEARCH_PREFERRED_PER_KEY_CONCURRENCY=
RESEARCH_PREFERRED_KEY_ACQUIRE_TIMEOUT_SECONDS=
RESEARCH_PREFERRED_GATEWAY_RETRIES=
# Direct-provider credentials cool down for 20 seconds by default. Managed gateways
# always skip local cooldown because the next request may select another upstream key.
RESEARCH_PREFERRED_RATE_LIMIT_COOLDOWN_SECONDS=
MIMO_MODEL_NAME=
MIMO_BASE_URL=
MIMO_API_KEY=
MIMO_EXTRA_API_KEYS=

# Embeddings. Keep both groups documented until the current naming mismatch is removed.
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BINDING_HOST=
EMBEDDING_BINDING_API_KEY=

# Search and page extraction providers
SERPER_API_KEY=
SERPER_EXTRA_API_KEYS=
SERPER_URL=https://google.serper.dev/search
TAVILY_EXTRACT_URL=
FIRECRAWL_SCRAPE_ENDPOINT=
CONTEXT7_BASE_URL=
URL_FETCH_PROVIDER_CHAIN=tavily,firecrawl,basic
SINGLE_URL_FETCH_PROVIDER_CHAIN=

# Signed research-plan tokens. Set the same high-entropy value on every
# production worker; an empty value uses a process-local development key.
RECON_TOKEN_SECRET=

# Feishu. Real writes are disabled in this template.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_OPEN_API_BASE=https://open.feishu.cn/open-apis
FEISHU_ENABLE_REAL_SEND=false
FEISHU_REPLY_FORMAT=post
FEISHU_DOC_DELIVERY_ENABLED=false
FEISHU_DOC_DELIVERY_FOR_FEISHU_CHANNELS=false
FEISHU_DOC_FOLDER_TOKEN=
FEISHU_RESEARCH_PROGRESS_PUSH=false

# Proactive learning push. Disabled until channel and delivery validation pass.
PUSH_SCHEDULER_ENABLED=false
PUSH_TICK_INTERVAL_SECONDS=600

# Local runtime and evaluation safety
OBSERVABILITY_DIR=
FEISHU_WS_HEARTBEAT_PATH=
RUNTIME_STATE_MONITOR_ENABLED=true
RESEARCH_CHECKPOINTS_ENABLED=1
RESEARCH_DEBUG_DUMP=false
RESEARCH_DEBUG_AGENT_TRACE=false
RESEARCH_DEBUG_REVISION_TRACE=false
RUN_LIVE_MODEL_TESTS=0
